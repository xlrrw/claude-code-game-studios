{
  "name": "LootCity",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "LootCityShared": { "$className": "Folder", "Config": { "$path": "src/shared/Config.lua" } }
    },
    "ServerScriptService": {
      "LootCityServer": {
        "$className": "Folder",
        "CityBuilder": { "$path": "src/server/CityBuilder.lua" },
        "ItemFactory": { "$path": "src/server/ItemFactory.lua" },
        "HomeBuilder": { "$path": "src/server/HomeBuilder.lua" },
        "AdminClient": { "$path": "src/server/AdminClient.client.lua" },
        "Server": { "$path": "src/server/Server.server.lua" }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": { "LootCityClient": { "$path": "src/client/Client.client.lua" } }
    }
  }
}
