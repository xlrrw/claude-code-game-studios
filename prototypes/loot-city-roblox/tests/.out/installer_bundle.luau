local cache = {}
function require(inst)
	if cache[inst] then return cache[inst] end
	local fn = assert(loadstring(inst.Source, inst.Name))
	setfenv(fn, setmetatable({ script = inst }, { __index = getfenv(1) }))
	cache[inst] = fn()
	return cache[inst]
end
